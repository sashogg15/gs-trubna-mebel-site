---
/** One machine in the equipment grid — name, manufacturer, model, year, parameters table. */
interface Props {
  machine: {
    name: string;
    manufacturer: string;
    model: string;
    year: string | number;
    parameters: { name: string; value: string }[];
  };
}
const { machine } = Astro.props;
---

<article class="flex flex-col border border-line">
  <div class="border-b border-line bg-mist px-6 py-5">
    <h3 class="font-heading text-h3 font-bold">{machine.name}</h3>
    <p class="mt-1 text-small text-steel">
      {machine.manufacturer} · {machine.model} · {machine.year}
    </p>
  </div>
  <dl class="flex-1 px-6 py-5">
    {
      machine.parameters.map((p) => (
        <div class="flex justify-between gap-4 border-b border-line py-2.5 text-small last:border-b-0">
          <dt class="text-steel">{p.name}</dt>
          <dd class="text-right font-medium">{p.value}</dd>
        </div>
      ))
    }
  </dl>
</article>
