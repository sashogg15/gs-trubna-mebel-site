---
import { loadShared } from '../lib/content';
import Logo from './Logo.astro';
import company from '../data/company.json';

const shared = loadShared();
const year = new Date().getFullYear();
const addr = company.contacts.address;
---

<footer class="bg-graphite text-steel-300">
  <div class="mx-auto grid max-w-site gap-12 px-6 py-12 md:grid-cols-3 md:px-12">
    <div>
      <Logo variant="full" tone="light" class="h-7" />
      {/* Descriptor line: typographic, visually separate from the logo —
          it must never read as part of the registered mark. (Spec called
          for steel-600, which measures 2.13:1 on graphite and is
          illegible; steel-300 is used instead — recorded in the review.) */}
      <p class="mt-4 text-label uppercase text-steel-300">{shared.footer.descriptor}</p>
      <p class="mt-4 max-w-xs text-body-sm">{shared.footer.tagline}</p>
    </div>

    <div class="text-body-sm">
      <p class="mb-3 text-label font-medium uppercase text-white">{shared.footer.contactHeading}</p>
      <p>{addr.street}</p>
      <p>{addr.postalCode} {addr.city}, {addr.country}</p>
      <p class="mt-2">{company.contacts.email}</p>
      <p>{company.contacts.phone}</p>
    </div>

    <div class="text-body-sm">
      <p class="mb-3 text-label font-medium uppercase text-white">{shared.footer.moreHeading}</p>
      <ul class="space-y-2">
        {/* /downloads is deliberately NOT linked while it is empty — a footer
            link to an empty page is worse than no link. Re-enable this line
            when the first real document is published there:
            <li><a href="/downloads" class="hover:text-white">{shared.footer.downloads}</a></li> */}
        <li><a href="/legal" class="hover:text-white">{shared.footer.legal}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-steel-600/40">
    <div class="mx-auto max-w-site px-6 py-4 text-body-sm md:px-12">
      © {year} {shared.footer.copyrightName}. {company.identity.registrationCity}.
    </div>
  </div>
</footer>
