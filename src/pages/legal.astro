---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { loadPage } from '../lib/content';
import company from '../data/company.json';

const t = loadPage('legal');
const L = t.identification.labels;
const office = company.contacts.address;
const production = company.contacts.productionAddress;

const rows = [
  { label: L.legalName, value: company.identity.legalName },
  { label: L.eik, value: company.identity.eik },
  { label: L.vat, value: company.identity.vatNumber },
  { label: L.registeredOffice, value: company.identity.registeredOffice },
  { label: L.managingDirectors, value: company.identity.managingDirectors },
  { label: L.office, value: `${office.street}, ${office.postalCode} ${office.city}, ${office.country}` },
  { label: L.production, value: `${production.street}, ${production.postalCode} ${production.city}, ${production.country}` },
  { label: L.email, value: company.contacts.email },
  { label: L.phone, value: company.contacts.phone },
];
---

<Base meta={{ title: t.meta.title, description: t.meta.description, path: '/legal' }}>
  <Section>
    <h1 class="font-heading text-display-1-m font-bold md:text-display-1">{t.identification.heading}</h1>
    <dl class="mt-6 max-w-prose divide-y divide-steel-100 border-b border-t border-steel-100">
      {
        rows.map((row) => (
          <div class="flex flex-col gap-1 py-4 md:flex-row md:justify-between md:gap-4">
            <dt class="shrink-0 text-body text-steel-600">{row.label}</dt>
            <dd class="text-body font-medium md:text-right">{row.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-4 max-w-prose text-body-sm text-steel-600">{t.identification.secondSiteNote}</p>
    <p class="mt-1 max-w-prose text-body-sm text-steel-600">{t.identification.addressConfirmNote}</p>
  </Section>

  <Section tone="white">
    <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.privacy.heading}</h2>
    <div class="mt-6 max-w-prose space-y-8">
      {
        t.privacy.sections.map((section: any) => (
          <div>
            <h3 class="font-heading text-heading-2 font-semibold">{section.title}</h3>
            <p class="mt-2 text-body text-steel-600">{section.body}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section>
    <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.terms.heading}</h2>
    <div class="mt-8 max-w-prose space-y-4">
      {t.terms.paragraphs.map((p: string) => <p class="text-body text-steel-600">{p}</p>)}
    </div>
  </Section>
</Base>
