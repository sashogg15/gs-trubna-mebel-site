---
/** Standard page header: h1 + intro paragraph. */
interface Props {
  heading: string;
  body?: string;
}
const { heading, body } = Astro.props;
---

<div class="max-w-prose">
  <h1 class="font-heading text-display-1-m font-bold md:text-display-1">{heading}</h1>
  {body && <p class="mt-6 text-body text-steel-600">{body}</p>}
</div>
