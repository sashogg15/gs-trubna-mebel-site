---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageIntro from '../components/PageIntro.astro';
import { loadPage } from '../lib/content';

const t = loadPage('downloads');

// Groups with actual files; the page shows an honest empty state until
// the first document exists. Entry shape: title, description, fileType,
// fileSize, language, file.
const groups = (t.groups as any[]).filter((g) => g.files.length > 0);
const isEmpty = groups.length === 0;
---

<Base meta={{ title: t.meta.title, description: t.meta.description, path: '/downloads' }}>
  <Section>
    <PageIntro heading={t.intro.heading} body={t.intro.body} />

    {
      isEmpty ? (
        <div class="mt-12 max-w-prose border border-steel-100 bg-white px-8 py-10">
          <h2 class="font-heading text-heading-2 font-semibold">{t.emptyState.heading}</h2>
          <p class="mt-3 text-body text-steel-600">{t.emptyState.body}</p>
          <a
            href={t.emptyState.ctaHref}
            class="mt-6 inline-block bg-ember-bright px-6 py-3 text-body-sm font-bold uppercase tracking-wide text-ink hover:bg-ember"
          >
            {t.emptyState.ctaLabel}
          </a>
        </div>
      ) : (
        <div class="mt-12 space-y-12">
          {groups.map((group) => (
            <div>
              <h2 class="font-heading text-heading-2 font-semibold">{group.heading}</h2>
              <ul class="mt-6 divide-y divide-steel-100 border-b border-t border-steel-100">
                {group.files.map((file: any) => (
                  <li>
                    <a
                      href={file.file}
                      class="flex flex-col gap-1 bg-white px-5 py-4 hover:text-ember-deep md:flex-row md:items-center md:justify-between md:gap-4"
                    >
                      <span>
                        <span class="block text-body font-medium">{file.title}</span>
                        {file.description && <span class="block text-body-sm text-steel-600">{file.description}</span>}
                      </span>
                      <span class="text-body-sm text-steel-600 md:shrink-0">
                        {[file.fileType, file.fileSize, file.language].join(", ")}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </Section>
</Base>
