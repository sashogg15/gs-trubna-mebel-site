---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';

const meta = {
  title: 'Page not found — GS Trubna Mebel',
  description: 'The page you are looking for does not exist.',
  path: '/404',
};
---

<Base meta={meta}>
  <Section>
    <div class="max-w-prose">
      <p class="font-heading text-figure-xl-m font-bold tabular-nums text-ember md:text-figure-xl">404</p>
      <h1 class="mt-4 font-heading text-figure font-bold tabular-nums">Page not found</h1>
      <a
        href="/"
        class="mt-6 inline-block border border-ink px-6 py-3 text-body-sm font-bold uppercase tracking-wide hover:border-ember-deep hover:text-ember-deep"
      >
        Back to home
      </a>
    </div>
  </Section>
</Base>
