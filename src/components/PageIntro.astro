---
/** Standard page header: h1 + intro paragraph. */
interface Props {
  heading: string;
  body?: string;
}
const { heading, body } = Astro.props;
---

<div class="max-w-3xl">
  <h1 class="font-heading text-h1 font-bold md:text-display">{heading}</h1>
  {body && <p class="mt-6 text-body text-steel">{body}</p>}
</div>
