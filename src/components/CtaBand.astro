---
interface Props {
  heading: string;
  body?: string;
  ctaLabel: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  heading,
  body,
  ctaLabel,
  ctaHref = '/request-a-quote',
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
  <div class="max-w-prose">
    <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{heading}</h2>
    {body && <p class="mt-4 text-body text-steel-600">{body}</p>}
  </div>
  <div class="flex shrink-0 flex-col items-start gap-4 md:flex-row md:items-center">
    <a
      href={ctaHref}
      class="rounded-field bg-ember-bright px-8 py-4 text-body font-bold uppercase tracking-wide text-ink hover:underline hover:underline-offset-4"
    >
      {ctaLabel}
    </a>
    {
      secondaryLabel && secondaryHref && (
        <a
          href={secondaryHref}
          class="text-body-sm font-bold uppercase tracking-wide text-ink underline underline-offset-4 hover:text-ember-deep"
        >
          {secondaryLabel}
        </a>
      )
    }
  </div>
</div>
