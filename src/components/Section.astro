---
/** Standard page section: vertical rhythm + max-width container. */
interface Props {
  /** 'paper' | 'mist' | 'graphite' */
  tone?: 'paper' | 'mist' | 'graphite';
  id?: string;
  class?: string;
}
const { tone = 'paper', id, class: className = '' } = Astro.props;
const tones = {
  paper: 'bg-paper text-ink',
  mist: 'bg-mist text-ink',
  graphite: 'bg-graphite text-paper',
};
---

<section id={id} class:list={[tones[tone], 'py-20 md:py-28', className]}>
  <div class="mx-auto max-w-site px-4 md:px-6">
    <slot />
  </div>
</section>
