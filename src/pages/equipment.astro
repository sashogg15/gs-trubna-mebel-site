---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageIntro from '../components/PageIntro.astro';
import SpecTable from '../components/SpecTable.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import { loadPage } from '../lib/content';
import { nbspUnits } from '../lib/format';
import { area, allMachines, findMachine, dash, nullFieldCount, type Machine } from '../lib/machines';
import company from '../data/company.json';

const t = loadPage('equipment');

// ---------------------------------------------------------------------------
// Build-time warning: the machine park is a client export with null fields
// waiting on the machine-plate photographs. Every null renders as an em
// dash; the count is printed so the distance to a complete table is visible.
const status = company.machinesStatus;
if (status.needsConfirmation || nullFieldCount() > 0) {
  console.warn(
    `\n[equipment] ${allMachines.length} machines, ${nullFieldCount()} fields still null (render as —). ` +
      `Source: ${status.source}\n  CONFIRM: ${status._confirm}\n`
  );
}
// ---------------------------------------------------------------------------

// {count} in the intro is computed from the data so it never diverges.
const introBody = t.intro.body.replace('{count}', String(allMachines.length));

// One spec table per production area (§7/§8). Every cell is derived from
// company.json; null → em dash (§8), never blank, never invented.
const C = t.table.columns;
const columns = [C.machine, C.make, C.model, C.count, C.control, C.range, C.capacity];
const toRow = (m: Machine): string[] => [
  m.name,
  dash(m.make),
  dash(m.model),
  dash(m.count),
  dash(m.control),
  nbspUnits(dash(m.range)),
  nbspUnits(dash(m.capacity)),
];

// Portraits: branded machines with CNC / robot / automated-line control.
const isPortrait = (m: Machine) =>
  /^(CNC|Robot|Automated)/i.test(m.control ?? '');

const chains = (['metal', 'wood'] as const).map((key) => {
  const areaList = (t.chains[key].areaKeys as string[])
    .map((k) => area(k))
    .filter((a): a is NonNullable<typeof a> => !!a && a.items.length > 0);
  return {
    key,
    heading: t.chains[key].heading,
    sequence: t.chains[key].sequence as string[],
    ground: key === 'metal' ? ('tint-metal' as const) : ('tint-wood' as const),
    areas: areaList,
    portraits: areaList.flatMap((a) => a.items.filter(isPortrait)),
  };
});

// Robotics counts derive from company.json — never hardcoded (§2.3).
const roboticsStats = t.robotics.stats.map((s: any) => ({
  label: s.label,
  value: dash(findMachine(s.area, s.make)?.count),
}));
---

<Base meta={{ title: t.meta.title, description: t.meta.description, path: '/equipment' }}>
  <Section>
    <PageIntro heading={t.intro.heading} body={introBody} />
  </Section>

  {
    chains.map((chain) => (
      <>
        <Section id={chain.key} tone={chain.ground}>
          <div class="border-t-4 border-ink pt-6">
            <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{chain.heading}</h2>
            <p class="mt-3 text-body text-steel-600">
              {chain.sequence.map((step, i) => (
                <>
                  {i > 0 && (
                    <span class="mx-3 inline-block h-3 w-px bg-steel-300 align-middle" aria-hidden="true" />
                  )}
                  <span class="whitespace-nowrap">{step}</span>
                </>
              ))}
            </p>
          </div>

          {chain.areas.map((a) => (
            <div class="mt-12">
              <h3 class="font-heading text-heading-2 font-semibold">{a.label}</h3>
              <div class="mt-6">
                <SpecTable
                  caption={`${chain.heading} — ${a.label}`}
                  columns={columns}
                  data={a.items.map(toRow)}
                  numericCols={[3]}
                  ground={chain.ground}
                  scrollHint={t.table.scrollHint}
                />
              </div>
            </div>
          ))}

          {chain.portraits.length > 0 && (
            <div class="mt-12">
              <h3 class="font-heading text-heading-2 font-semibold">{t.portraits.heading}</h3>
              <div class="mt-6 grid grid-cols-2 gap-6 md:grid-cols-4">
                {chain.portraits.map((m) => (
                  <ImagePlaceholder
                    aspect="4/3"
                    label={`${t.portraits.photoLabel} — ${m.make ? m.make + (m.model ? ' ' + m.model : '') : m.name}, machine label legible, landscape`}
                  />
                ))}
              </div>
            </div>
          )}
        </Section>

        {chain.key === 'metal' && (
          <Section tone="graphite">
            <div class="grid items-center gap-12 md:grid-cols-3">
              <div class="md:col-span-2">
                <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.robotics.heading}</h2>
                <p class="mt-4 max-w-prose text-body text-steel-300">{t.robotics.body}</p>
              </div>
              <div class="flex gap-12">
                {roboticsStats.map((stat) => (
                  <div>
                    <p class="font-heading text-figure font-bold tabular-nums leading-none text-white">{stat.value}</p>
                    <p class="mt-2 text-body-sm text-steel-300">{stat.label}</p>
                  </div>
                ))}
              </div>
            </div>
          </Section>
        )}
      </>
    ))
  }

  <Section>
    <CtaBand heading={t.closingCta.heading} body={t.closingCta.body} ctaLabel={t.closingCta.ctaLabel} />
  </Section>
</Base>
