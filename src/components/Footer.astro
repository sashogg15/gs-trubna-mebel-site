---
import { loadShared } from '../lib/content';
import company from '../data/company.json';

const shared = loadShared();
const year = new Date().getFullYear();
const addr = company.contacts.address;
---

<footer class="bg-graphite text-fog">
  <div class="mx-auto grid max-w-site gap-10 px-4 py-14 md:grid-cols-3 md:px-6">
    <div>
      <p class="font-heading text-h3 font-bold uppercase text-paper">
        {company.identity.brandName}
      </p>
      <p class="mt-3 max-w-xs text-small">{shared.footer.tagline}</p>
    </div>

    <div class="text-small">
      <p class="mb-3 text-label uppercase text-paper">Contact</p>
      <p>{addr.street}</p>
      <p>{addr.postalCode} {addr.city}, {addr.country}</p>
      <p class="mt-2">{company.contacts.email}</p>
      <p>{company.contacts.phone}</p>
    </div>

    <div class="text-small">
      <p class="mb-3 text-label uppercase text-paper">More</p>
      <ul class="space-y-2">
        <li><a href="/downloads" class="hover:text-paper">{shared.footer.downloads}</a></li>
        <li><a href="/legal" class="hover:text-paper">{shared.footer.legal}</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-steel/40">
    <div class="mx-auto max-w-site px-4 py-4 text-small md:px-6">
      © {year} {shared.footer.copyrightName}. {company.identity.registrationCity}.
    </div>
  </div>
</footer>
