---
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
  title: string;
  body: string;
  href: string;
  linkLabel: string;
  /** Factory/machine/process photo only — never product or lifestyle shots. */
  image?: { src: string; alt: string; aspect: string };
  /**
   * Structural chain tint — 'bg-tint-metal' | 'bg-tint-wood'. Used only
   * for the Metal and Wood blocks on the home page; never elsewhere.
   */
  tint?: string;
}
const { title, body, href, linkLabel, image, tint } = Astro.props;
---

<div class:list={['flex flex-col border-t-2 border-ink pt-6', tint && `${tint} px-5 pb-6`]}>
  {
    image && (
      <ImagePlaceholder
        src={image.src}
        alt={image.alt}
        aspect={image.aspect}
        label={`Factory photo — ${title}`}
        class="mb-6"
      />
    )
  }
  <h3 class="font-heading text-h3 font-bold uppercase">{title}</h3>
  <p class="mt-4 flex-1 text-body text-steel-600">{body}</p>
  <a href={href} class="mt-6 inline-block text-small font-bold uppercase tracking-wide text-ember-deep hover:text-ink">
    {linkLabel} →
  </a>
</div>
