---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';

const meta = {
  title: 'Page not found — GS Trubna Mebel',
  description: 'The page you are looking for does not exist.',
  path: '/404',
};
---

<Base meta={meta}>
  <Section>
    <div class="max-w-2xl">
      <p class="font-heading text-figure font-bold text-signal">404</p>
      <h1 class="mt-4 font-heading text-h1 font-bold">Page not found</h1>
      <a
        href="/"
        class="mt-10 inline-block border border-ink px-6 py-3 text-small font-bold uppercase tracking-wide hover:border-signal hover:text-signal"
      >
        Back to home
      </a>
    </div>
  </Section>
</Base>
