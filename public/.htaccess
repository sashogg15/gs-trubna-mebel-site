# =============================================================================
# GS Trubna Mebel — Apache configuration (cPanel / SuperHosting shared hosting)
# This file is copied verbatim into dist/ by the Astro build and must be
# uploaded to public_html together with the rest of the build output.
# =============================================================================

# --- Canonical host + HTTPS --------------------------------------------------
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Force non-www (adjust if www is preferred)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# =============================================================================
# --- 301 REDIRECTS FROM OLD WORDPRESS URLS -----------------------------------
#
#   [[TODO: paste the list of existing WordPress URLs here, one rule per URL.]]
#
#   Format (old path -> new path), examples:
#     Redirect 301 /за-нас/            /about/
#     Redirect 301 /продукти/          /capabilities/
#     Redirect 301 /kontakti/          /request-a-quote/
#     Redirect 301 /wp-content/uploads/2020/brochure.pdf  /downloads/
#
#   Rules for building the list:
#     - Every indexed/linked old URL gets a redirect to its closest new page.
#     - Anything with no equivalent redirects to / .
#     - URL-encoded Cyrillic paths must be pasted exactly as they appear
#       in the old sitemap/Search Console (percent-encoded form).
#
# --- BEGIN OLD URL REDIRECTS -------------------------------------------------

# (paste redirects here)

# --- END OLD URL REDIRECTS ---------------------------------------------------
# =============================================================================

# --- Error documents ---------------------------------------------------------
ErrorDocument 404 /404.html

# --- Caching -----------------------------------------------------------------
# Hashed assets (Astro puts them in /_astro/) are immutable.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=600"
  </FilesMatch>
</IfModule>

# --- Compression -------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# --- Basic hardening ---------------------------------------------------------
Options -Indexes
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
