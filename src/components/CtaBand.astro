---
interface Props {
  heading: string;
  body?: string;
  ctaLabel: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}
const {
  heading,
  body,
  ctaLabel,
  ctaHref = '/request-a-quote',
  secondaryLabel,
  secondaryHref,
} = Astro.props;
---

<div class="flex flex-col items-start justify-between gap-8 md:flex-row md:items-center">
  <div class="max-w-2xl">
    <h2 class="font-heading text-h2 font-bold">{heading}</h2>
    {body && <p class="mt-4 text-body text-steel">{body}</p>}
  </div>
  <div class="flex shrink-0 flex-col items-start gap-4 sm:flex-row sm:items-center">
    <a
      href={ctaHref}
      class="bg-signal px-8 py-4 text-body font-bold uppercase tracking-wide text-paper hover:bg-signal-dark"
    >
      {ctaLabel}
    </a>
    {
      secondaryLabel && secondaryHref && (
        <a
          href={secondaryHref}
          class="text-small font-bold uppercase tracking-wide text-signal hover:text-signal-dark"
        >
          {secondaryLabel} →
        </a>
      )
    }
  </div>
</div>
