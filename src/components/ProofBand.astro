---
/** Dark proof band: certifications, solar capacity, years in operation — all from company.json. */
import company from '../data/company.json';
import { isTodo } from '../lib/content';

interface Props {
  heading: string;
}
const { heading } = Astro.props;

const certs = company.certifications.items;
const solar = company.sustainability.solarInstallations;
const years = new Date().getFullYear() - company.identity.foundedYear;
---

<div class="grid gap-10 md:grid-cols-3">
  <div>
    <h2 class="font-heading text-h2 font-bold">{heading}</h2>
  </div>

  <div>
    <p class="text-label uppercase text-fog">Certifications</p>
    <ul class="mt-4 space-y-3">
      {
        certs.map((c) => (
          <li class="flex items-center gap-3 border border-steel/40 px-4 py-3">
            {/* [[TODO: replace with certification logo images once supplied]] */}
            <span class="text-body font-bold">{c.name}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="space-y-8">
    <div>
      <p class="text-label uppercase text-fog">Years in operation</p>
      <p class="mt-2 font-heading text-h1 font-bold text-signal">{years}</p>
      <p class="text-small text-fog">since {company.identity.foundedYear}</p>
    </div>
    <div>
      <p class="text-label uppercase text-fog">On-site solar</p>
      {
        solar.map((s) => (
          <p class="mt-2 font-heading text-h2 font-bold text-signal">
            {s.capacityKwp}
            {!isTodo(String(s.capacityKwp)) && <span class="text-h3"> kWp</span>}
          </p>
        ))
      }
    </div>
  </div>
</div>
