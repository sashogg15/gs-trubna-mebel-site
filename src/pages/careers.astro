---
// Careers is in Bulgarian — local recruitment in Dobrich, not export clients.
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageIntro from '../components/PageIntro.astro';
import { loadPage } from '../lib/content';

const t = loadPage('careers');
---

<Base meta={{ title: t.meta.title, description: t.meta.description, path: '/careers', lang: 'bg' }}>
  <Section>
    <PageIntro heading={t.intro.heading} body={t.intro.body} />
  </Section>

  <Section tone="mist">
    <h2 class="font-heading text-h2 font-bold">{t.openPositions.heading}</h2>
    {
      t.openPositions.items.length === 0 ? (
        <p class="mt-6 max-w-3xl text-body text-steel">{t.openPositions.emptyMessage}</p>
      ) : (
        <div class="mt-10 grid gap-6 md:grid-cols-2">
          {t.openPositions.items.map((job: any) => (
            <article class="border border-line bg-paper px-6 py-6">
              <h3 class="font-heading text-h3 font-bold">{job.title}</h3>
              <p class="mt-1 text-small text-steel">
                {job.type} · {job.location}
              </p>
              <p class="mt-4 text-body text-steel">{job.body}</p>
            </article>
          ))}
        </div>
      )
    }
  </Section>

  <Section>
    <div class="max-w-3xl">
      <h2 class="font-heading text-h2 font-bold">{t.howToApply.heading}</h2>
      <p class="mt-6 text-body text-steel">{t.howToApply.body}</p>
      <p class="mt-4 text-body font-medium">{t.howToApply.email}</p>
      <p class="text-body font-medium">{t.howToApply.phone}</p>
    </div>
  </Section>
</Base>
