---
interface Props {
  items: { year: string; event: string }[];
}
const { items } = Astro.props;
---

<ol class="border-l-2 border-steel-100">
  {
    items.map((item) => (
      <li class="flex items-start gap-4 pb-12 pl-6 last:pb-0">
        <span class="mt-2 h-3 w-3 shrink-0 bg-ink" aria-hidden="true" />
        <div>
          <p class="font-heading text-heading-2 font-semibold tabular-nums text-ember-deep">{item.year}</p>
          <p class="mt-1 text-body text-steel-600">{item.event}</p>
        </div>
      </li>
    ))
  }
</ol>
