---
/** Compact card for non-highlighted machines in the equipment grid. */
import { nbspUnits } from '../lib/format';

interface Props {
  machine: {
    id: string;
    name: string;
    manufacturer: string;
    model: string;
    year: string | number;
    count: string | number;
    parameters: { name: string; value: string }[];
  };
  description: string;
  stageLabel: string;
  labels: Record<string, string>;
}
const { machine, description, stageLabel, labels } = Astro.props;
const countLabel =
  machine.count === 1 || machine.count === '1' ? labels.unit : labels.units;
---

<article class="flex flex-col border border-steel-100 bg-white">
  <div class="border-b border-steel-100 px-6 py-5">
    <p class="text-label uppercase text-steel-600">{stageLabel}</p>
    <h3 class="mt-1 font-heading text-h3 font-bold leading-tight">{machine.name}</h3>
    <p class="mt-1 text-small text-steel-600">
      {machine.manufacturer}{machine.model && ` · ${machine.model}`} · {machine.count}
      {countLabel}
    </p>
  </div>
  <div class="flex flex-1 flex-col px-6 py-5">
    <p class="text-small">{nbspUnits(description)}</p>
    {
      machine.parameters.length > 0 && (
        <dl class="mt-4 border-t border-steel-100">
          {machine.parameters.map((p) => (
            <div class="flex justify-between gap-4 border-b border-steel-100 py-2 text-small last:border-b-0">
              <dt class="shrink-0 text-steel-600">{p.name}</dt>
              <dd class="text-right font-medium tabular-nums">{nbspUnits(p.value)}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</article>
