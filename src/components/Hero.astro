---
import ImagePlaceholder from './ImagePlaceholder.astro';

interface Props {
  headline: string;
  subline: string;
  /** Smaller third line — establishes OEM/discretion; do not cut. */
  supportLine?: string;
  ctaLabel: string;
  ctaHref: string;
  image: { src: string; alt: string; aspect: string };
}
const { headline, subline, supportLine, ctaLabel, ctaHref, image } = Astro.props;
---

<section class="relative bg-graphite text-white">
  <div class="absolute inset-0">
    <ImagePlaceholder
      src={image.src}
      alt={image.alt}
      aspect={image.aspect}
      label="Factory photo — wide shot of a production hall (never product/lifestyle)"
      eager={true}
      class="h-full w-full opacity-40"
    />
  </div>
  <div class="relative mx-auto max-w-site px-6 py-16 md:px-12 md:py-24">
    <h1 class="max-w-4xl font-heading text-display-1-m font-bold md:text-display-1">{headline}</h1>
    <p class="mt-6 max-w-prose text-body text-white">{subline}</p>
    {supportLine && <p class="mt-4 max-w-prose text-body-sm text-steel-300">{supportLine}</p>}
    <a
      href={ctaHref}
      class="mt-6 inline-block bg-ember-bright px-8 py-4 text-body font-bold uppercase tracking-wide text-ink hover:bg-ember"
    >
      {ctaLabel}
    </a>
  </div>
</section>
