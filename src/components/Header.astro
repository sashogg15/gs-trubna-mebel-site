---
import { loadShared } from '../lib/content';
import Logo from './Logo.astro';

const shared = loadShared();
const nav = [
  { href: '/', label: shared.nav.home },
  { href: '/capabilities', label: shared.nav.capabilities },
  { href: '/equipment', label: shared.nav.equipment },
  { href: '/quality', label: shared.nav.quality },
  { href: '/sustainability', label: shared.nav.sustainability },
  { href: '/references', label: shared.nav.references },
  { href: '/about', label: shared.nav.about },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => current === (href === '/' ? '/' : href);
---

<header class="sticky top-0 z-40 border-b border-steel-100 bg-white">
  <div class="mx-auto flex max-w-site items-center justify-between gap-3 px-6 py-4 md:gap-6 md:px-12">
    <a href="/" class="flex shrink-0 items-center">
      <Logo variant="full" tone="dark" class="h-7 md:h-8" />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
            class:list={[
              // Active state carries no accent (budget: the RFQ button is
              // the header's one accent element).
              'whitespace-nowrap text-body-sm font-medium uppercase tracking-wide hover:text-ink',
              isCurrent(item.href) ? 'border-b-2 border-ink pb-0.5 text-ink' : 'text-steel-600',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <a
        href="/request-a-quote"
        class="whitespace-nowrap rounded-field bg-ember-bright px-2.5 py-2 text-label font-bold uppercase tracking-wide text-ink hover:bg-ember md:px-5 md:py-2.5 md:text-body-sm"
      >
        {shared.nav.rfqButton}
      </a>

      <!-- Mobile nav: <details>/<summary> — no JavaScript, works everywhere (§2.6). -->
      <details class="relative lg:hidden">
        <summary
          class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-field border border-steel-100"
          aria-label={shared.a11y.menuLabel}
        >
          <span class="block h-0.5 w-5 bg-ink" aria-hidden="true"></span>
        </summary>
        <nav
          class="absolute right-0 top-11 z-50 w-64 border border-steel-100 bg-white shadow-overlay"
          aria-label="Main mobile"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'block border-b border-steel-100 px-4 py-3 text-body font-medium uppercase tracking-wide last:border-b-0',
                  isCurrent(item.href) ? 'text-ink' : 'text-steel-600',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
