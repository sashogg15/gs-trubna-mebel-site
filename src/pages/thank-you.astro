---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import { loadPage, isTodo } from '../lib/content';

const t = loadPage('thank-you');

// The response-time step renders once filled; in production an unfilled
// TODO is omitted rather than shipping a vague placeholder.
const steps = (t.steps as string[]).filter((s) => !isTodo(s) || import.meta.env.DEV);
---

<Base meta={{ title: t.meta.title, description: t.meta.description, path: '/thank-you' }}>
  <Section>
    <div class="max-w-2xl">
      <h1 class="font-heading text-h1 font-bold">{t.heading}</h1>
      <p class="mt-6 text-body text-steel-600">{t.body}</p>
      <ol class="mt-6 space-y-4">
        {
          steps.map((step, i) => (
            <li class="flex items-start gap-4">
              <span class="font-heading text-h3 font-bold text-ember">{String(i + 1).padStart(2, '0')}</span>
              <p class="pt-1 text-body">{step}</p>
            </li>
          ))
        }
      </ol>
      <p class="mt-8 text-small text-steel-600">{t.note}</p>
      <a
        href="/"
        class="mt-10 inline-block border border-ink px-6 py-3 text-small font-bold uppercase tracking-wide hover:border-ember hover:text-ember"
      >
        {t.backLabel}
      </a>
    </div>
  </Section>
</Base>
