---
/** Large-type key figures strip, fed exclusively from company.json. */
import company from '../data/company.json';

const figures = company.keyFigures.items;
---

<section class="border-b border-t border-steel-100 bg-white">
  <div class="mx-auto grid max-w-site grid-cols-2 gap-x-6 gap-y-12 px-6 py-12 md:grid-cols-4 md:px-12">
    {
      figures.map((f, i) => (
        <div>
          {/* Accent budget: one accent element per viewport — the first
              figure carries it, the rest stay ink. */}
          <p
            class:list={[
              'break-words font-heading text-figure-xl-m font-bold tabular-nums md:text-figure-xl',
              i === 0 ? 'text-ember' : 'text-ink',
            ]}
          >
            {f.value}
            {f.unit && <span class="text-heading-2 font-semibold">{f.unit}</span>}
          </p>
          <p class="mt-2 text-body-sm text-steel-600">{f.label}</p>
        </div>
      ))
    }
  </div>
</section>
