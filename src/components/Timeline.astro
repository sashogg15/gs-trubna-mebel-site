---
interface Props {
  items: { year: string; event: string }[];
}
const { items } = Astro.props;
---

<ol class="border-l-2 border-line">
  {
    items.map((item) => (
      <li class="relative pb-10 pl-8 last:pb-0">
        <span class="absolute -left-[7px] top-1.5 h-3 w-3 bg-signal" aria-hidden="true" />
        <p class="font-heading text-h3 font-bold text-signal">{item.year}</p>
        <p class="mt-1 text-body text-steel">{item.event}</p>
      </li>
    ))
  }
</ol>
