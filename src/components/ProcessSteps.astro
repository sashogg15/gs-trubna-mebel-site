---
/**
 * Numbered process sequence; stacks on mobile.
 * Steps with `emphasis` carry more visual weight (signal top border) —
 * on the home page these are tooling (repeatability) and series
 * production (short runs → full series).
 */
interface Props {
  steps: { title: string; body: string; emphasis?: boolean }[];
}
const { steps } = Astro.props;
---

<ol class="grid gap-8 md:grid-cols-3">
  {
    steps.map((step, i) => (
      <li
        class:list={[
          'pt-6',
          step.emphasis ? 'border-t-4 border-ink' : 'border-t-2 border-steel-100',
        ]}
      >
        <span
          class:list={[
            'font-heading text-figure font-bold tabular-nums',
            step.emphasis ? 'text-ink' : 'text-steel-600',
          ]}
        >
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="mt-2 font-heading text-heading-2 font-semibold">{step.title}</h3>
        <p class="mt-2 text-body-sm text-steel-600">{step.body}</p>
      </li>
    ))
  }
</ol>
