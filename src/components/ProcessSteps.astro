---
/**
 * Numbered process sequence; stacks on mobile.
 * Steps with `emphasis` carry more visual weight (signal top border) —
 * on the home page these are tooling (repeatability) and series
 * production (short runs → full series).
 */
interface Props {
  steps: { title: string; body: string; emphasis?: boolean }[];
}
const { steps } = Astro.props;
---

<ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
  {
    steps.map((step, i) => (
      <li
        class:list={[
          'pt-6',
          step.emphasis ? 'border-t-4 border-signal' : 'border-t-2 border-line',
        ]}
      >
        <span
          class:list={[
            'font-heading text-h2 font-bold',
            step.emphasis ? 'text-signal' : 'text-steel',
          ]}
        >
          {String(i + 1).padStart(2, '0')}
        </span>
        <h3 class="mt-2 font-heading text-body font-bold uppercase">{step.title}</h3>
        <p class="mt-2 text-small text-steel">{step.body}</p>
      </li>
    ))
  }
</ol>
