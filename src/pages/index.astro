---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import KeyFigures from '../components/KeyFigures.astro';
import Section from '../components/Section.astro';
import CapabilityBlock from '../components/CapabilityBlock.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import LogoWall from '../components/LogoWall.astro';
import CtaBand from '../components/CtaBand.astro';
import { loadPage } from '../lib/content';
import { nbspUnits } from '../lib/format';
import company from '../data/company.json';
import { area, findMachine, dash } from '../lib/machines';

const t = loadPage('home');

// ---------------------------------------------------------------------------
// Build-time warning: interview-sourced key figures still unconfirmed.
const unconfirmed = (company.keyFigures.items as any[]).filter((f) => f.needsConfirmation);
if (unconfirmed.length > 0) {
  console.warn(
    `\n[home] ${unconfirmed.length} key figure(s) still need confirmation before launch:\n` +
      unconfirmed
        .map((f) => `  - "${f.value}${f.unit} — ${f.label}" (source: ${f.source ?? 'unknown'})`)
        .join('\n') +
      '\n'
  );
}
// ---------------------------------------------------------------------------

const years = new Date().getFullYear() - company.identity.foundedYear;
// Robot counts derive from company.json machine counts — never literals.
const robotCells = (area('welding')?.items ?? [])
  .filter((x) => /robot/i.test(x.control ?? ''))
  .reduce((n, x) => n + (x.count ?? 0), 0);
const robots = `${dash(robotCells || null)}+${dash(findMachine('surface-coating', 'KUKA')?.count)}`;
const proofStats = t.proofBand.stats.map((s: any) => ({
  ...s,
  value: s.value.replace('{years}', String(years)).replace('{robots}', robots),
}));

// Version A/B switch for the client section: named logo wall renders only
// when permission is confirmed in company.json (clients.permissionToDisplay).
const showClientNames =
  company.clients.permissionToDisplay && company.clients.named.length > 0;
---

<Base meta={{ title: t.meta.title, description: t.meta.description, path: '/' }}>
  <!-- 1. Hero — capacity-first positioning. -->
  <Hero
    headline={t.hero.headline}
    subline={t.hero.subline}
    supportLine={t.hero.supportLine}
    locationLine={t.hero.locationLine}
    ctaLabel={t.hero.ctaLabel}
    ctaHref="/request-a-quote"
    image={t.hero.backgroundImage}
  />

  <!-- 2. Key figures — four real numbers, no fillers. -->
  <KeyFigures />

  <!-- 3. What we manufacture: Metal, Wood, Complete programmes — in this order. -->
  <Section>
    <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.capabilityBlocks.heading}</h2>
    <div class="mt-6 grid gap-12 md:grid-cols-3">
      {/* Structural chain tints on Metal and Wood only — Complete stays untinted. */}
      {
        t.capabilityBlocks.items.map((item: any, i: number) => (
          <CapabilityBlock {...item} tint={['bg-tint-metal', 'bg-tint-wood', undefined][i]} />
        ))
      }
    </div>
  </Section>

  <!-- 3a. What we do not do — OEM only; tells a brand we are not a
       future competitor. Deliberately placed early, not a footnote. -->
  <Section>
    <div class="max-w-prose border-t-4 border-ink pt-6">
      <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.oemOnly.heading}</h2>
      <p class="mt-6 text-body-lg">{t.oemOnly.body}</p>
    </div>
  </Section>

  <!-- 4. How we work — six stages; 3 and 4 carry emphasis. -->
  <Section>
    <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.howWeWork.heading}</h2>
    <div class="mt-6">
      <ProcessSteps steps={t.howWeWork.steps} />
    </div>
  </Section>

  <!-- 5. Repeatability — proof point, not a topic. -->
  <Section tone="graphite">
    <div class="max-w-prose">
      <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.repeatability.heading}</h2>
      <ul class="mt-6 space-y-2">
        {
          t.repeatability.lines.map((line: string) => (
            <li class="flex items-start gap-3 text-body text-steel-300">
              <span class="mt-2.5 h-1.5 w-1.5 shrink-0 bg-steel-300" aria-hidden="true" />
              {nbspUnits(line)}
            </li>
          ))
        }
      </ul>
      <a
        href={t.repeatability.linkHref}
        class="mt-8 inline-block text-body-sm font-bold uppercase tracking-wide text-white underline underline-offset-4 hover:text-steel-300"
      >
        {t.repeatability.linkLabel}
      </a>
    </div>
  </Section>

  <!-- 6. Why a European partner — concrete arguments, location stated plainly. -->
  <Section>
    <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.whyEurope.heading}</h2>
    <div class="mt-6 grid gap-8 md:grid-cols-4">
      {
        t.whyEurope.points.map((point: any) => (
          <div class="border-t-2 border-steel-100 pt-5">
            <h3 class="font-heading text-heading-2 font-semibold">{point.title}</h3>
            <p class="mt-2 text-body-sm text-steel-600">{point.body}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-6 text-body-sm text-steel-600">{t.whyEurope.locationNote}</p>
  </Section>

  <!-- 7. Clients / proof band — Version B (no names) until permission is confirmed. -->
  <Section tone="graphite">
    {
      showClientNames && (
        <div class="mb-12">
          <LogoWall logos={company.clients.named} />
        </div>
      )
    }
    <div class="grid gap-12 md:grid-cols-2">
      <div>
        <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.proofBand.heading}</h2>
        <p class="mt-4 text-body text-steel-300">{t.proofBand.body}</p>
      </div>
      <div class="grid grid-cols-3 items-end gap-6">
        {
          proofStats.map((stat: any, i: number) => (
            <div>
              {/* One accent per viewport: first stat only; ember at figure
                  size passes 3.09:1 large-text on graphite. */}
              <p
                class:list={[
                  'font-heading text-figure font-bold tabular-nums leading-none',
                  i === 0 ? 'text-ember' : 'text-white',
                ]}
              >
                {stat.value}
              </p>
              <p class="mt-2 text-body-sm text-steel-300">{stat.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </Section>

  <!-- 8. Family ownership — brief, and only after credibility is established. -->
  <Section>
    <div class="max-w-prose">
      <h2 class="font-heading text-heading-2 font-semibold">{t.family.heading}</h2>
      <p class="mt-4 text-body text-steel-600">{t.family.body}</p>
    </div>
  </Section>

  <!-- 9. Closing CTA — names what the buyer receives. -->
  <Section>
    <CtaBand heading={t.closingCta.heading} body={t.closingCta.body} ctaLabel={t.closingCta.ctaLabel} />
  </Section>
</Base>
