---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageIntro from '../components/PageIntro.astro';
import SpecTable from '../components/SpecTable.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import CtaBand from '../components/CtaBand.astro';
import { loadPage } from '../lib/content';
import { nbspUnits } from '../lib/format';
import company from '../data/company.json';

const t = loadPage('equipment');
const machines = company.machines.items as any[];

// ---------------------------------------------------------------------------
// Build-time warning: every machine still carrying needsConfirmation or a
// [[TODO]] marker is listed in the build output so the whole list can be
// confirmed with production before launch.
const flagged = machines.filter(
  (m) => m.needsConfirmation || JSON.stringify(m).includes('[[TODO')
);
if (flagged.length > 0) {
  const lines = flagged.map((m) => {
    const todos = (JSON.stringify(m).match(/\[\[TODO/g) || []).length;
    const parts = [`  - ${m.name} (${m.manufacturer}${m.model ? ' ' + m.model : ''})`];
    if (todos > 0) parts.push(`— ${todos} open [[TODO]]`);
    if (m._confirm) parts.push(`— CONFIRM: ${m._confirm}`);
    return parts.join(' ');
  });
  console.warn(
    `\n[equipment] ${flagged.length} of ${machines.length} machines need confirmation with production before launch:\n` +
      lines.join('\n') +
      '\n'
  );
}
// ---------------------------------------------------------------------------

// {count} in the intro is computed from the data so it never diverges.
const introBody = t.intro.body.replace('{count}', String(machines.length));

// One spec table per production area (§7/§8): the table row is derived
// entirely from company.json. "Working range and features" joins every
// parameter except the tolerance, which gets its own column.
const isTolerance = (name: string) => /tolerance/i.test(name);
const toRow = (m: any): string[] => [
  m.name,
  m.manufacturer,
  m.model,
  String(m.count),
  nbspUnits(
    m.parameters
      .filter((p: any) => !isTolerance(p.name))
      .map((p: any) => `${p.name}: ${p.value}`)
      .join('; ')
  ),
  nbspUnits(m.parameters.find((p: any) => isTolerance(p.name))?.value ?? ''),
];

const C = t.table.columns;
const tableColumns = [C.machine, C.make, C.model, C.count, C.workingRange, C.tolerance];

// Machines stay in company.json process order within each area.
const chains = (['metal', 'wood'] as const).map((key) => ({
  key,
  heading: t.chains[key].heading,
  sequence: t.chains[key].sequence,
  ground: key === 'metal' ? ('tint-metal' as const) : ('tint-wood' as const),
  areas: t.chains[key].areas
    .map((area: any) => ({
      label: area.label,
      machines: machines.filter(
        (m) => m.chain === key && area.categories.includes(m.category)
      ),
    }))
    .filter((area: any) => area.machines.length > 0),
  portraits: machines.filter((m) => m.chain === key && m.highlight),
}));

// Robotics counts derive from company.json — never hardcoded (§2.3).
const roboticsStats = t.robotics.stats.map((s: any) => ({
  label: s.label,
  value: String(machines.find((m) => m.id === s.machineId)?.count ?? '—'),
}));
---

<Base meta={{ title: t.meta.title, description: t.meta.description, path: '/equipment' }}>
  <Section>
    <PageIntro heading={t.intro.heading} body={introBody} />
  </Section>

  {
    chains.map((chain) => (
      <>
        <Section id={chain.key} tone={chain.ground}>
          <div class="border-t-4 border-ink pt-6">
            <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{chain.heading}</h2>
            <p class="mt-3 text-body text-steel-600">
              {chain.sequence.map((step: string, i: number) => (
                <>
                  {i > 0 && (
                    <span class="mx-2 text-steel-600" aria-hidden="true">
                      →
                    </span>
                  )}
                  <span class="whitespace-nowrap">{step}</span>
                </>
              ))}
            </p>
          </div>

          {chain.areas.map((area: any) => (
            <div class="mt-12">
              <h3 class="font-heading text-heading-2 font-semibold">{area.label}</h3>
              <div class="mt-6">
                <SpecTable
                  caption={`${chain.heading} — ${area.label}`}
                  columns={tableColumns}
                  data={area.machines.map(toRow)}
                  numericCols={[3]}
                  ground={chain.ground}
                  scrollHint={t.table.scrollHint}
                />
              </div>
            </div>
          ))}

          {chain.portraits.length > 0 && (
            <div class="mt-12">
              <h3 class="font-heading text-heading-2 font-semibold">{t.portraits.heading}</h3>
              <div class="mt-6 grid grid-cols-2 gap-6 md:grid-cols-4">
                {chain.portraits.map((m: any) => (
                  <ImagePlaceholder
                    aspect="4/3"
                    label={`${t.portraits.photoLabel} — ${m.manufacturer} ${m.model || m.name}, machine label legible, landscape`}
                  />
                ))}
              </div>
            </div>
          )}
        </Section>

        {chain.key === 'metal' && (
          <Section tone="graphite">
            <div class="grid items-center gap-12 md:grid-cols-3">
              <div class="md:col-span-2">
                <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.robotics.heading}</h2>
                <p class="mt-4 max-w-prose text-body text-steel-300">{t.robotics.body}</p>
              </div>
              <div class="flex gap-12">
                {roboticsStats.map((stat) => (
                  <div>
                    <p class="font-heading text-figure font-bold tabular-nums leading-none text-white">{stat.value}</p>
                    <p class="mt-2 text-body-sm text-steel-300">{stat.label}</p>
                  </div>
                ))}
              </div>
            </div>
          </Section>
        )}
      </>
    ))
  }

  <Section>
    <CtaBand heading={t.closingCta.heading} body={t.closingCta.body} ctaLabel={t.closingCta.ctaLabel} />
  </Section>
</Base>
