---
import { loadShared } from '../lib/content';
import Logo from './Logo.astro';

const shared = loadShared();
const nav = [
  { href: '/', label: shared.nav.home },
  { href: '/capabilities', label: shared.nav.capabilities },
  { href: '/equipment', label: shared.nav.equipment },
  { href: '/quality', label: shared.nav.quality },
  { href: '/sustainability', label: shared.nav.sustainability },
  { href: '/references', label: shared.nav.references },
  { href: '/about', label: shared.nav.about },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-steel-100 bg-white">
  <div class="mx-auto flex max-w-site items-center justify-between gap-3 px-4 py-4 md:gap-6 md:px-6">
    <a href="/" class="flex shrink-0 items-center">
      <Logo variant="full" tone="dark" class="h-7 md:h-8" />
    </a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={current === (item.href === '/' ? '/' : item.href) ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap text-small font-medium uppercase tracking-wide hover:text-ember',
              current === (item.href === '/' ? '/' : item.href) ? 'text-ember' : 'text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2 md:gap-3">
      <a
        href="/request-a-quote"
        class="whitespace-nowrap bg-ember px-2.5 py-2 text-[0.6875rem] font-bold uppercase tracking-wide text-white hover:bg-ember-bright sm:text-label md:px-5 md:py-2.5 md:text-small"
      >
        {shared.nav.rfqButton}
      </a>

      <button
        type="button"
        class="flex h-9 w-9 shrink-0 items-center justify-center border border-steel-100 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Menu"
        id="menu-toggle"
      >
        <span class="block h-0.5 w-5 bg-ink" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-steel-100 lg:hidden" aria-label="Main mobile">
    <div class="mx-auto max-w-site px-4 py-3 md:px-6">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="block border-b border-steel-100 py-3 text-body font-medium uppercase tracking-wide last:border-b-0"
          >
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
