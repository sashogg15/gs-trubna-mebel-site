---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageIntro from '../components/PageIntro.astro';
import Timeline from '../components/Timeline.astro';
import CtaBand from '../components/CtaBand.astro';
import { loadPage, loadShared } from '../lib/content';
import company from '../data/company.json';

const t = loadPage('about');
const shared = loadShared();
const sites = company.sites.items;
---

<Base meta={{ title: t.meta.title, description: t.meta.description, path: '/about' }}>
  <Section>
    <PageIntro heading={t.intro.heading} body={t.intro.body} />
  </Section>

  <Section>
    <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.timeline.heading}</h2>
    <div class="mt-6 max-w-prose">
      <Timeline items={t.timeline.items} />
    </div>
  </Section>

  <Section>
    <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.sites.heading}</h2>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {
        sites.map((site) => (
          <div class="border border-steel-100 px-6 py-6">
            <h3 class="font-heading text-heading-2 font-semibold">{site.name}</h3>
            <p class="mt-1 text-body-sm text-steel-600">{site.location}</p>
            <p class="mt-4 font-heading text-figure font-bold tabular-nums text-ink">
              {site.areaM2}
              <span class="text-heading-2 font-semibold"> m²</span>
            </p>
            <p class="mt-3 text-body text-steel-600">{site.function}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <Section>
    <div class="max-w-prose">
      <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.people.heading}</h2>
      <p class="mt-6 text-body text-steel-600">{t.people.body}</p>
    </div>
  </Section>

  <Section>
    <div class="max-w-prose">
      <h2 class="font-heading text-display-2-m font-bold md:text-display-2">{t.position.heading}</h2>
      <p class="mt-6 text-body text-steel-600">{t.position.body}</p>
    </div>
  </Section>

  <Section tone="graphite">
    <CtaBand heading={shared.cta.closingTitle} body={shared.cta.closingBody} ctaLabel={shared.cta.primary} />
  </Section>
</Base>
